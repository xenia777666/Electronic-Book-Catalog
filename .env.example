POSTGRES_DB=library_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
APP_PORT=8080

# Optional: insert 11 demo books on startup if the DB has no books yet
# APP_SEED_ENABLED=true

